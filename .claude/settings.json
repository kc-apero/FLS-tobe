{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/soi_cau_phu_dinh.py",
            "timeout": 10,
            "statusMessage": "soi cau phu dinh dinh luong"
          }
        ]
      }
    ]
  }
}
